[Unit]
Description=Independent Astra research reviewer (read-only evidence access)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/data/openai-agent/mobile-robot-mppi-study
ExecStart=/usr/bin/python3 -u /data/openai-agent/mobile-robot-mppi-study/scripts/research_service/astra_reviewer.py
Restart=on-failure
RestartSec=60
MemoryHigh=400M
MemoryMax=600M
CPUQuota=15%
Nice=15
IOSchedulingClass=idle
TasksMax=32
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/data/openai-agent/state /data/openai-agent/mobile-robot-mppi-study/docs/bohn2021_takeover/astra_reviews
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
